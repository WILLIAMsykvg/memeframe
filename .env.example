# Copy to .env and fill in only what you use.
# 复制为 .env，用到哪项再填哪项。

MEMEFRAME_HOME=data
MEMEFRAME_AGENT=0
MEMEFRAME_API_KEY=
MEMEFRAME_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMEFRAME_CAPTION_MODEL=qwen-vl-plus
MEMEFRAME_EMBED_MODEL=text-embedding-v3
MEMEFRAME_REWRITE_MODEL=qwen-turbo
MEMEFRAME_SOURCE_TIMEOUT=8
MEMEFRAME_MAX_UPLOAD_BYTES=5242880

# Remote JSON source. Leave empty to keep the adapter disabled.
# 远程 JSON 源。留空则该适配器保持关闭。
MEMEFRAME_HTTP_SOURCE_URL=
MEMEFRAME_HTTP_SOURCE_HEADER=

# Optional hotlink proxy. Placeholders: {URL} {SOURCE_URL} {REFERER}
# 可选防盗链代理。
IMAGE_PROXY_URL=
